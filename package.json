    "@nuxt/test-utils": "4.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^20.14.6",
    "typescript": "^6.0.3",
